1.Total Orders MOM VAR = 
VAR MOM = [Total Orders MOM%]

RETURN
SWITCH(
    TRUE(),
    MOM > 0,
    UNICHAR(9650)& " " & FORMAT(MOM, "0.00%"),
    MOM <0,
    UNICHAR(9660)& " " & FORMAT(MOM, "0.00%"),
    "-0.00%"
)
2. Total Orders MOM% = 

VAR Prev_Month =
CALCULATE(
    [Total Orders],
    DATEADD(
        Date_Table[Date],
        -1,
        MONTH
    )
)
RETURN

DIVIDE(
    [Total Orders] - Prev_Month,
    Prev_Month,
    0
)

