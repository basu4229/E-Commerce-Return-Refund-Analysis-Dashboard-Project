charts
1. Cumalative Return  units = 
VAR Currentrank = 
[Return Reason Rank]

RETURN

SUMX(
    FILTER(
        ALLSELECTED(Dim_ReturnReason[Return_Reason]),
        [Return Reason Rank] <= Currentrank 
    ),
    [Returned Units]
)

2.Cumaltive Returns % = 
DIVIDE(
    [Cumalative Return  units],
    CALCULATE([Returned Units],
    ALLSELECTED(Dim_ReturnReason[Return_Reason])
    ),
    0
)
3.Refund Amount = 
CALCULATE(
    SUMX(
        Fact_Orders,
        Fact_Orders[Return_Quantity]
        *Fact_Orders[Unit_Price]
        *(1-Fact_Orders[Discount_Pct])
        *(1-Fact_Orders[Refund_Deduction_Pct])
    ),
    Fact_Orders[Return_Flag] = "Yes"
)
4. Return Reason Rank = 
RANKX(
    ALLSELECTED(Dim_ReturnReason[Return_Reason]),
    [Returned Units],
    ,DESC,Dense
)
5.Returned Units = 
SUM(Fact_Orders[Return_Quantity])

