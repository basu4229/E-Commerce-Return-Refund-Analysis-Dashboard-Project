1.Product Return Colour = 
VAR ProductReturnRate = 
[Return Rate %]

VAR OverallReturnRate = 
CALCULATE(
    [Return Rate %],
    REMOVEFILTERS(Dim_Products[Product_Name])
)

RETURN

SWITCH(
    TRUE(),
    ISBLANK(ProductReturnRate),"#E8E3E3",
    ProductReturnRate > OverallReturnRate * 1.20,"#A52A3A",
    ProductReturnRate > OverallReturnRate, "#D96773",
    "#F3C5C9"
)
2. Top Return Category = 

VAR TopCategoryTable =
TOPN(
    1,
    VALUES(Dim_Products[Category]),
    [Returned Units],
    DESC
)
RETURN
CONCATENATEX(
    TopCategoryTable,
    Dim_Products[Category],
    ","
)
3. Top Return Reason = 

VAR TopReturnReason =
TOPN(
    1,
    VALUES(Dim_ReturnReason[Return_Reason]),
    [Returned Units],
    DESC,
    Dim_ReturnReason[Return_Reason],
    ASC
)

RETURN
CONCATENATEX(
    TopReturnReason,
    Dim_ReturnReason[Return_Reason],
    ","
)

Date_Table = 
VAR MinDate =
    MIN ( Fact_Orders[Order_Date] )
VAR MaxDate =
    MAX ( Fact_Orders[Order_Date] )
RETURN
ADDCOLUMNS (
    CALENDAR ( MinDate, MaxDate ),
    "Year", YEAR ( [Date] ),
    "Quarter", "Q" & QUARTER ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month Name", FORMAT ( [Date], "MMM" ),
    "Month Short", FORMAT ( [Date], "MMM" ),
    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
    "Month Year", FORMAT ( [Date], "MMM YYYY" ),
    "Week Number", WEEKNUM ( [Date], 2 ),
    "Day", DAY ( [Date] ),
    "Day Name", FORMAT ( [Date], "dddd" ),
    "Day Short", FORMAT ( [Date], "ddd" ),
    "Day of Week", WEEKDAY ( [Date], 2 ),
    "Is Weekend", IF ( WEEKDAY ( [Date], 2 ) >= 6, "Yes", "No" )
)
